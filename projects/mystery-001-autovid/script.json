      }
    },
    {
      "id": 9,
      "text": "Nhận định đây là một vụ việc có tính chất đặc biệt nghiêm trọng, Đức Anh cùng tổ công tác lập tức lên đường.",
      "image_file": "images/scene_009.png",
      "ken_burns": {
