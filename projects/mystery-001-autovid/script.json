          "for_sentences": 2
        }
      ],
      "sfx": [
        {
          "file": "data/sfx/thud.mp3",
          "time_offset_ms": 1200,
          "volume": 0.5
        }
      ]
    },
    {
      "id": 4,
      "text": "Đêm muộn ngày mười lăm tháng mười, tại trung tâm chỉ huy của lực lượng cảnh sát phản ứng nhanh 113, bầu không khí đang trôi đi trong sự tĩnh lặng tương đối của ca trực đêm. Đúng 23 giờ 47 phút, hệ thống tiếp nhận cuộc gọi đổ chuông.",
      "image_file": "images/scene_004.png",
      "ken_burns": {
        "enabled": true,
        "type": "pan_left",
        "start_scale": 1.1,
        "end_scale": 1.1
      },
      "transition_in": {
        "type": "pixelize",
        "duration": 0.4
      }
    },
    {
      "id": 5,
      "text": "Viên sĩ quan trực máy nhanh chóng nhấc điện thoại. Đầu dây bên kia là một giọng nam thều thào, đứt quãng nhưng lộ rõ sự hoảng loạn tột độ. Giọng nói vang lên giữa những tiếng thở dốc nặng nề: \"Cứu tôi với... Có người đột nhập... Căn hộ năm không hai, chung cư Hoa Mai...",
      "image_file": "images/scene_005.png",
      "ken_burns": {
        "enabled": true,
        "type": "pan_down",
        "start_scale": 1.1,
        "end_scale": 1.1
