    },
    {
      "id": 6,
      "text": "Hắn muốn giết... Á!\". Một tiếng động mạnh như vật thể đổ vỡ vang lên, theo sau đó là tiếng tút dài lạnh lẽo. Cuộc gọi bị ngắt hoàn toàn.",
      "image_file": "images/scene_006.png",
      "ken_burns": {
        "enabled": true,
        "type": "zoom_in",
        "start_scale": 1.04,
        "end_scale": 1.14
      },
      "transition_in": {
        "type": "circle_open",
        "duration": 0.4
      }
    },
    {
      "id": 7,
      "text": "Ngay lập tức, thông tin được chuyển tới Đội Cảnh sát hình sự Công an quận Hai Bà Trưng. Đại úy Nguyễn Đức Anh, một điều tra viên dày dặn kinh nghiệm với ba mươi tám tuổi đời và hơn mười lăm năm tuổi nghề, được giao nhiệm vụ tiếp cận hiện trường.",
      "image_file": "images/scene_007.png",
      "ken_burns": {
        "enabled": true,
        "type": "zoom_in",
        "start_scale": 1.0,
        "end_scale": 1.08
      },
      "transition_in": {
        "type": "cut",
        "duration": 0.0
      },
      "characters": [
        {
