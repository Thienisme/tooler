        }
      ]
    },
    {
      "id": 2,
      "text": "Được xây dựng từ những thập niên cuối thế kỷ trước, tòa nhà mang trên mình lớp sơn vàng ố đã bong tróc, những mảng tường rêu phong ẩm mốc và một mê lộ những đường dây điện, dây cáp chằng chịt như mạng nhện. Trong không gian chật hẹp ấy, âm thanh dường như không bao giờ tắt.",
      "image_file": "images/scene_002.png",
      "ken_burns": {
        "enabled": true,
        "type": "pan_right",
        "start_scale": 1.1,
        "end_scale": 1.1
      },
      "transition_in": {
        "type": "slide_left",
        "duration": 0.4
      }
    },
    {
      "id": 3,
      "text": "Tiếng còi xe inh ỏi từ đường lớn vọng vào, tiếng động cơ xe máy lạch cạch của những người đi làm muộn, và cả tiếng sinh hoạt rì rầm của các hộ dân sống san sát nhau tạo nên một bản nhạc nền hỗn độn, đặc trưng của cuộc sống đô thị đất chật người đông.",
      "image_file": "images/scene_003.png",
      "ken_burns": {
        "enabled": true,
        "type": "zoom_out",
        "start_scale": 1.12,
        "end_scale": 1.0
      },
      "transition_in": {
        "type": "cut",
        "duration": 0.0
      },
      "characters": [
        {
          "image_file": "assets/characters/host_idle.png",
          "preset": "whoosh",
          "x": 0.2,
          "y": 0.97,
          "height": 0.52,
