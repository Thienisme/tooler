  "scenes": [
    {
      "id": 1,
      "text": "Ở cổng làng Vũ Đại, Chí Phèo bước ra, vừa giận dữ vừa chẳng biết đi đâu. Thị Nở tiến lại gần, còn mấy người trong làng đứng xa nhìn theo. Cả khung hình dồn về phía hai người, để câu chuyện chính luôn nổi bật giữa đám đông.",
      "image_file": "projects/demo_story_inside/images/backgrounds/village_gate.png",
